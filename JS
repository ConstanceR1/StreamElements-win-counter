let escapes = 0;
let deaths = 0;

const escapeEl = document.getElementById("escapesCount");
const deathEl = document.getElementById("deathsCount");
const fxLayer = document.getElementById("fxLayer");
const deathIconBox = document.getElementById("deathIconBox");
const escapeIconBox = document.getElementById("escapeIconBox");

const escapeSound = "{{escapeSound}}";
const deathSound = "{{deathSound}}";
const FX_SCALE = parseFloat("{{fxScale}}") || 1.8;

function playSound(url) {
  if (!url) return;
  const audio = new Audio(url);
  audio.volume = 0.7;
  audio.play().catch(() => {});
}

function render() {
  escapeEl.textContent = escapes;
  deathEl.textContent = deaths;
}

function animateValue(el, className) {
  el.classList.remove("bump", "flash-escape", "flash-death");
  void el.offsetWidth;
  el.classList.add("bump");
  if (className) el.classList.add(className);
  setTimeout(() => {
    el.classList.remove("bump", "flash-escape", "flash-death");
  }, 500);
}

function flashEl(el, className, ms = 600) {
  el.classList.remove(className);
  void el.offsetWidth;
  el.classList.add(className);
  setTimeout(() => el.classList.remove(className), ms);
}

function spawnParticle({
  text = "✦",
  className = "",
  x = 0,
  y = 0,
  color = "#fff",
  size = 18,
  dx = "0px",
  dy = "-20px",
  dur = 1000,
  rot = "0deg"
}) {
  const el = document.createElement("div");
  el.className = `fx-particle ${className}`;
  el.textContent = text;
  el.style.left = `${x}px`;
  el.style.top = `${y}px`;
  el.style.color = color;
  el.style.fontSize = `${size}px`;
  el.style.setProperty("--dx", dx);
  el.style.setProperty("--dy", dy);
  el.style.setProperty("--dur", `${dur}ms`);
  el.style.setProperty("--rot", rot);
  fxLayer.appendChild(el);
  setTimeout(() => el.remove(), dur + 150);
}

function burstEscapeFX() {
  const rect = fxLayer.getBoundingClientRect();
  const originX = rect.width * 0.28;
  const originY = rect.height * 0.50;
  const distBase = 40 * FX_SCALE;

  const glitterColors = ["#fff7b8", "#ffd84d", "#ffffff", "#ff9ce6"];
  for (let i = 0; i < 18; i++) {
    const angle = Math.random() * Math.PI * 2;
    const dist = distBase + Math.random() * (60 * FX_SCALE);
    const dx = `${Math.cos(angle) * dist}px`;
    const dy = `${Math.sin(angle) * dist}px`;

    spawnParticle({
      text: Math.random() > 0.5 ? "✦" : "✨",
      className: "fx-glitter",
      x: originX,
      y: originY,
      color: glitterColors[Math.floor(Math.random() * glitterColors.length)],
      size: (16 + Math.random() * 22) * FX_SCALE,
      dx,
      dy,
      dur: 900 + Math.random() * 400
    });
  }

  const heartColors = ["#27e8ff", "#ff2e9f", "#ffb300", "#b86cff"];
  for (let i = 0; i < 12; i++) {
    const angle = (-Math.PI / 2) + ((Math.random() - 0.5) * 1.6);
    const dist = distBase + Math.random() * (70 * FX_SCALE);
    const dx = `${Math.cos(angle) * dist}px`;
    const dy = `${Math.sin(angle) * dist}px`;

    spawnParticle({
      text: Math.random() > 0.5 ? "♡" : "♥",
      className: "fx-heart",
      x: originX,
      y: originY,
      color: heartColors[Math.floor(Math.random() * heartColors.length)],
      size: (22 + Math.random() * 26) * FX_SCALE,
      dx,
      dy,
      dur: 1000 + Math.random() * 350
    });
  }

  flashEl(escapeIconBox, "escape-burst", 600);
}

function burstDeathFX() {
  flashEl(deathIconBox, "skull-flash", 550);

  const rect = fxLayer.getBoundingClientRect();
  const originX = rect.width * 0.73;
  const originY = rect.height * 0.50;
  const distBase = 36 * FX_SCALE;

  const skullColors = ["#ff73bf", "#ffffff", "#c86cff", "#ffb3e6"];
  const glitterColors = ["#ff73bf", "#ffffff", "#ffd24d", "#c86cff"];

  for (let i = 0; i < 12; i++) {
    const angle = Math.random() * Math.PI * 2;
    const dist = distBase + Math.random() * (70 * FX_SCALE);
    const dx = `${Math.cos(angle) * dist}px`;
    const dy = `${Math.sin(angle) * dist}px`;
    const rot = `${-180 + Math.random() * 360}deg`;

    spawnParticle({
      text: "💀",
      className: "fx-skull",
      x: originX,
      y: originY,
      color: skullColors[Math.floor(Math.random() * skullColors.length)],
      size: (26 + Math.random() * 28) * FX_SCALE,
      dx,
      dy,
      dur: 950 + Math.random() * 400,
      rot
    });
  }

  for (let i = 0; i < 12; i++) {
    const angle = Math.random() * Math.PI * 2;
    const dist = 28 * FX_SCALE + Math.random() * (50 * FX_SCALE);
    const dx = `${Math.cos(angle) * dist}px`;
    const dy = `${Math.sin(angle) * dist}px`;

    spawnParticle({
      text: Math.random() > 0.5 ? "✦" : "✨",
      className: "fx-glitter",
      x: originX,
      y: originY,
      color: glitterColors[Math.floor(Math.random() * glitterColors.length)],
      size: (14 + Math.random() * 16) * FX_SCALE,
      dx,
      dy,
      dur: 800 + Math.random() * 300
    });
  }
}

function spawnRandomSparkle() {
  const rect = fxLayer.getBoundingClientRect();
  const x = 20 + Math.random() * (rect.width - 40);
  const y = 8 + Math.random() * (rect.height - 16);
  const colors = ["#ffffff", "#ffd24d", "#ff7de1", "#27e8ff"];

  spawnParticle({
    text: Math.random() > 0.5 ? "✦" : "⋆",
    className: "fx-random-star",
    x,
    y,
    color: colors[Math.floor(Math.random() * colors.length)],
    size: 8 + Math.random() * 8,
    dx: `${-6 + Math.random() * 12}px`,
    dy: `${-8 - Math.random() * 18}px`,
    dur: 1200 + Math.random() * 1200
  });
}

function spawnShootingStar() {
  const rect = fxLayer.getBoundingClientRect();
  const fromLeft = Math.random() > 0.5;

  const el = document.createElement("div");
  el.className = "fx-particle fx-shooting-star";
  el.textContent = "✦";

  const startX = fromLeft ? -10 : rect.width + 10;
  const startY = 20 + Math.random() * (rect.height - 40);
  const endX = fromLeft ? rect.width + 20 : -20;
  const endY = startY + (-20 + Math.random() * 40);

  el.style.left = "0px";
  el.style.top = "0px";
  el.style.color = ["#ffffff", "#ffd24d", "#ff7de1", "#27e8ff"][Math.floor(Math.random() * 4)];
  el.style.setProperty("--sx", `${startX}px`);
  el.style.setProperty("--sy", `${startY}px`);
  el.style.setProperty("--ex", `${endX}px`);
  el.style.setProperty("--ey", `${endY}px`);
  el.style.setProperty("--dur", `${900 + Math.random() * 700}ms`);

  fxLayer.appendChild(el);
  setTimeout(() => el.remove(), 1800);
}

function addEscape() {
  escapes++;
  render();
  animateValue(escapeEl, "flash-escape");
  playSound(escapeSound);
  burstEscapeFX();
}

function addDeath() {
  deaths++;
  render();
  animateValue(deathEl, "flash-death");
  playSound(deathSound);
  burstDeathFX();
}

function removeEscape() {
  escapes = Math.max(0, escapes - 1);
  render();
  animateValue(escapeEl, "flash-escape");
}

function removeDeath() {
  deaths = Math.max(0, deaths - 1);
  render();
  animateValue(deathEl, "flash-death");
}

function resetBoard() {
  escapes = 0;
  deaths = 0;
  render();
}

function setEscapeCount(value) {
  const n = parseInt(value, 10);
  if (!isNaN(n)) escapes = Math.max(0, n);
  render();
  animateValue(escapeEl, "flash-escape");
}

function setDeathCount(value) {
  const n = parseInt(value, 10);
  if (!isNaN(n)) deaths = Math.max(0, n);
  render();
  animateValue(deathEl, "flash-death");
}

window.addEventListener("onWidgetLoad", function (obj) {
  const fieldData = obj.detail.fieldData || {};
  escapes = parseInt(fieldData.startEscapes || 0, 10);
  deaths = parseInt(fieldData.startDeaths || 0, 10);
  render();

  setInterval(() => {
    if (Math.random() < 0.8) spawnRandomSparkle();
  }, 650);

  setInterval(() => {
    if (Math.random() < 0.65) spawnShootingStar();
  }, 2200);
});

window.addEventListener("onEventReceived", function (obj) {
  const listener = obj.detail.listener;
  const event = obj.detail.event;

  if (listener !== "message") return;

  const data = event.data || {};
  const text = (data.text || "").trim().toLowerCase();
  const badges = data.badges || "";
  const isBroadcaster = badges.includes("broadcaster");
  const isMod = badges.includes("moderator");

  if ({{modsOnly}} && !(isBroadcaster || isMod)) return;

  if (text === "{{cmdEscape}}".toLowerCase()) return addEscape();
  if (text === "{{cmdDeath}}".toLowerCase()) return addDeath();
  if (text === "{{cmdMinusEscape}}".toLowerCase()) return removeEscape();
  if (text === "{{cmdMinusDeath}}".toLowerCase()) return removeDeath();
  if (text === "{{cmdReset}}".toLowerCase()) return resetBoard();

  if (text.startsWith("{{cmdSetEscapes}}".toLowerCase() + " ")) {
    return setEscapeCount(text.split(" ")[1]);
  }

  if (text.startsWith("{{cmdSetDeaths}}".toLowerCase() + " ")) {
    return setDeathCount(text.split(" ")[1]);
  }
});
