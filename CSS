@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800&family=Nunito:wght@700;800;900&display=swap');

:root {
  --borderPink: {{borderPink}};
  --textWhite: {{textWhite}};
  --escapeColor: {{escapeColor}};
  --deathColor: {{deathColor}};
  --dividerColor: {{dividerColor}};

  --iconBoxTop: {{iconBoxTop}};
  --iconBoxBottom: {{iconBoxBottom}};

  --heartLeft: {{heartLeft}};
  --heartRight: {{heartRight}};
  --heartCenterLeft: {{heartCenterLeft}};
  --heartCenterRight: {{heartCenterRight}};

  --star1: {{star1}};
  --star2: {{star2}};
  --star3: {{star3}};
}

html, body {
  margin: 0;
  padding: 0;
  width: {{widgetWidth}}px;
  height: {{widgetHeight}}px;
  background: transparent;
  overflow: visible;
  font-family: 'Nunito', sans-serif;
}

.neon-wrap {
  width: 100%;
  height: 100%;
  padding: 50px 60px; /* ⬅️ increase this */
  box-sizing: border-box;
  overflow: visible;
  background: transparent;
  position: relative;
}

.neon-bar {
  width: 100%;
  height: 100%;
  position: relative;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 28px;
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.03);
  overflow: visible;
}

.neon-bar::before {
  content: "";
  position: absolute;
  inset: -12px;
  border-radius: 999px;
  pointer-events: none;
  z-index: 0;

  box-shadow:
    0 0 12px rgba(255, 77, 184, 1),
    0 0 28px rgba(255, 77, 184, 0.75),
    0 0 55px rgba(255, 77, 184, 0.45),
    0 0 95px rgba(255, 77, 184, 0.25);

  animation: outerGlowPulse 3s ease-in-out infinite;
}

.fx-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: visible;
  border-radius: inherit;
  z-index: 10;
}

.side {
  width: 46%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
  position: relative;
  z-index: 2;
}

.stat-wrap {
  min-width: 110px;
  text-align: center;
}

.label {
  font-family: 'Orbitron', sans-serif;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 6px;
}

.escapes {
  color: var(--escapeColor);
  text-shadow:
    0 0 4px var(--escapeColor),
    0 0 10px var(--escapeColor),
    0 0 22px rgba(70, 255, 246, 0.8),
    0 0 40px rgba(70, 255, 246, 0.28);
}

.deaths {
  color: var(--deathColor);
  text-shadow:
    0 0 4px var(--deathColor),
    0 0 10px var(--deathColor),
    0 0 22px rgba(255, 97, 178, 0.8),
    0 0 40px rgba(255, 97, 178, 0.28);
}

.count {
  color: var(--textWhite);
  font-family: 'Orbitron', sans-serif;
  font-size: 62px;
  font-weight: 800;
  line-height: 1;
  text-shadow:
    0 0 4px rgba(255,255,255,0.95),
    0 0 10px rgba(255,255,255,0.85),
    0 0 24px rgba(255,255,255,0.5),
    0 0 42px rgba(255,255,255,0.22);
  transition: transform 0.2s ease, filter 0.2s ease;
}

.icon-box {
  width: 82px;
  height: 82px;
  border-radius: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  background: linear-gradient(180deg, var(--iconBoxTop), var(--iconBoxBottom));
  border: 2px solid rgba(255,255,255,0.24);
  box-shadow:
    0 0 8px rgba(180, 80, 255, 0.7),
    0 0 18px rgba(180, 80, 255, 0.4),
    0 0 34px rgba(180, 80, 255, 0.18),
    inset 0 0 10px rgba(255,255,255,0.08);
}

.icon-box::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  box-shadow:
    0 0 6px rgba(255,255,255,0.15),
    0 0 14px rgba(167, 90, 255, 0.22);
}

.icon-img {
  width: 50px;
  height: 50px;
  object-fit: contain;
  filter:
    drop-shadow(0 0 4px rgba(255,255,255,0.95))
    drop-shadow(0 0 12px rgba(255,255,255,0.45))
    drop-shadow(0 0 20px rgba(196, 129, 255, 0.30));
  z-index: 1;
}

.divider {
  width: 2px;
  height: 84px;
  border-radius: 999px;
  background: var(--dividerColor);
  box-shadow:
    0 0 6px rgba(255,255,255,0.8),
    0 0 18px rgba(255,255,255,0.35);
  animation: dividerPulse 2.4s ease-in-out infinite;
  z-index: 2;
}

.heart,
.star {
  position: absolute;
  pointer-events: none;
  z-index: 3;
}

.heart {
  font-size: 24px;
  line-height: 1;
  animation-name: floatCrazy;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}

.heart-left-big {
  left: 18px;
  top: -10px;
  color: var(--heartLeft);
  text-shadow:
    0 0 6px var(--heartLeft),
    0 0 16px var(--heartLeft),
    0 0 30px rgba(0, 234, 255, 0.38);
  animation-duration: 2.6s;
}

.heart-right-big {
  right: 18px;
  top: -10px;
  color: var(--heartRight);
  text-shadow:
    0 0 6px var(--heartRight),
    0 0 16px var(--heartRight),
    0 0 30px rgba(255, 0, 132, 0.4);
  animation-duration: 3.2s;
}

.heart-mid-left {
  left: 41%;
  top: 50%;
  transform: translate(-50%, -50%);
  color: var(--heartCenterLeft);
  font-size: 18px;
  text-shadow:
    0 0 6px var(--heartCenterLeft),
    0 0 14px var(--heartCenterLeft);
  animation-name: pulseTiny;
  animation-duration: 2.2s;
}

.heart-mid-right {
  left: 59%;
  top: 50%;
  transform: translate(-50%, -50%);
  color: var(--heartCenterRight);
  font-size: 18px;
  text-shadow:
    0 0 6px var(--heartCenterRight),
    0 0 14px var(--heartCenterRight);
  animation-name: pulseTiny;
  animation-duration: 2.8s;
}

.star {
  font-size: 13px;
  opacity: .9;
  animation-name: sparkleFloat;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}

.star-1 {
  left: 8%;
  bottom: 10px;
  color: var(--star1);
  text-shadow: 0 0 8px var(--star1), 0 0 18px var(--star1);
  animation-duration: 2.1s;
}
.star-2 {
  left: 18%;
  top: -2px;
  color: var(--star2);
  text-shadow: 0 0 8px var(--star2), 0 0 18px var(--star2);
  animation-duration: 2.8s;
}
.star-3 {
  left: 46%;
  top: 8px;
  color: var(--star3);
  text-shadow: 0 0 8px var(--star3), 0 0 18px var(--star3);
  animation-duration: 2.3s;
}
.star-4 {
  right: 46%;
  bottom: 10px;
  color: var(--star1);
  text-shadow: 0 0 8px var(--star1), 0 0 18px var(--star1);
  animation-duration: 3.0s;
}
.star-5 {
  right: 18%;
  top: -2px;
  color: var(--star2);
  text-shadow: 0 0 8px var(--star2), 0 0 18px var(--star2);
  animation-duration: 2.6s;
}
.star-6 {
  right: 8%;
  bottom: 8px;
  color: var(--star3);
  text-shadow: 0 0 8px var(--star3), 0 0 18px var(--star3);
  animation-duration: 3.2s;
}

.bump {
  animation: bump .35s ease;
}

.flash-escape {
  animation: flashEscape .45s ease;
}

.flash-death {
  animation: flashDeath .45s ease;
}

.skull-flash {
  animation: skullFlash .55s ease;
}

.escape-burst {
  animation: escapeSideBurst .6s ease;
}

.fx-particle {
  position: absolute;
  pointer-events: none;
  line-height: 1;
  z-index: 20;
  will-change: transform, opacity;
}

.fx-glitter {
  text-shadow:
    0 0 6px currentColor,
    0 0 14px currentColor,
    0 0 24px rgba(255,255,255,0.18);
  animation: glitterBurst var(--dur, 900ms) ease-out forwards;
}

.fx-heart {
  text-shadow:
    0 0 6px currentColor,
    0 0 14px currentColor,
    0 0 24px rgba(255,255,255,0.15);
  animation: heartBurst var(--dur, 1000ms) ease-out forwards;
}

.fx-skull {
  z-index: 30;
  text-shadow:
    0 0 6px currentColor,
    0 0 14px currentColor,
    0 0 28px currentColor,
    0 0 40px rgba(255,255,255,0.12);
  animation: skullBurst var(--dur, 1000ms) ease-out forwards;
}

.fx-random-star {
  text-shadow:
    0 0 6px currentColor,
    0 0 12px currentColor;
  animation: randomSpawn var(--dur, 1800ms) ease-out forwards;
}

.fx-shooting-star {
  font-size: 16px;
  text-shadow:
    0 0 6px currentColor,
    0 0 12px currentColor,
    0 0 24px currentColor;
  animation: shootingStar var(--dur, 1300ms) linear forwards;
}

@keyframes outerGlowPulse {
  0% {
    box-shadow:
      0 0 12px rgba(255, 77, 184, 0.95),
      0 0 24px rgba(255, 77, 184, 0.75),
      0 0 42px rgba(255, 77, 184, 0.45),
      0 0 72px rgba(255, 77, 184, 0.22),
      0 0 110px rgba(255, 77, 184, 0.12);
  }
  50% {
    box-shadow:
      0 0 18px rgba(255, 77, 184, 1),
      0 0 34px rgba(255, 77, 184, 0.85),
      0 0 58px rgba(255, 77, 184, 0.55),
      0 0 92px rgba(255, 77, 184, 0.28),
      0 0 135px rgba(255, 77, 184, 0.16);
  }
  100% {
    box-shadow:
      0 0 12px rgba(255, 77, 184, 0.95),
      0 0 24px rgba(255, 77, 184, 0.75),
      0 0 42px rgba(255, 77, 184, 0.45),
      0 0 72px rgba(255, 77, 184, 0.22),
      0 0 110px rgba(255, 77, 184, 0.12);
  }
}

@keyframes dividerPulse {
  0% { opacity: .7; }
  50% { opacity: 1; }
  100% { opacity: .7; }
}

@keyframes floatCrazy {
  0%   { transform: translate(0px, 0px) scale(1); opacity: 0.7; }
  25%  { transform: translate(-4px, -6px) scale(1.1); opacity: 1; }
  50%  { transform: translate(3px, -10px) scale(1.15); opacity: 0.85; }
  75%  { transform: translate(-2px, -4px) scale(1.05); opacity: 1; }
  100% { transform: translate(0px, 0px) scale(1); opacity: 0.7; }
}

@keyframes pulseTiny {
  0% { opacity: .65; transform: translate(-50%, -50%) scale(1); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.12); }
  100% { opacity: .65; transform: translate(-50%, -50%) scale(1); }
}

@keyframes sparkleFloat {
  0%   { transform: translate(0px, 0px) scale(0.9); opacity: 0.2; }
  30%  { transform: translate(4px, -6px) scale(1.2); opacity: 1; }
  60%  { transform: translate(-2px, -2px) scale(1); opacity: 0.6; }
  100% { transform: translate(0px, 0px) scale(0.9); opacity: 0.2; }
}

@keyframes bump {
  0% { transform: scale(1); }
  35% { transform: scale(1.18); }
  100% { transform: scale(1); }
}

@keyframes flashEscape {
  0% { filter: brightness(1); }
  40% { filter: brightness(1.65) drop-shadow(0 0 10px rgba(70,255,246,.85)); }
  100% { filter: brightness(1); }
}

@keyframes flashDeath {
  0% { filter: brightness(1); }
  40% { filter: brightness(1.65) drop-shadow(0 0 10px rgba(255,97,178,.85)); }
  100% { filter: brightness(1); }
}

@keyframes skullFlash {
  0% {
    box-shadow:
      0 0 8px rgba(180, 80, 255, 0.55),
      0 0 18px rgba(180, 80, 255, 0.24),
      inset 0 0 10px rgba(255,255,255,0.08);
  }
  35% {
    box-shadow:
      0 0 16px rgba(255, 75, 150, 0.95),
      0 0 30px rgba(255, 75, 150, 0.6),
      0 0 60px rgba(255, 75, 150, 0.25),
      inset 0 0 16px rgba(255,255,255,0.15);
  }
  100% {
    box-shadow:
      0 0 8px rgba(180, 80, 255, 0.55),
      0 0 18px rgba(180, 80, 255, 0.24),
      inset 0 0 10px rgba(255,255,255,0.08);
  }
}

@keyframes escapeSideBurst {
  0% {
    box-shadow:
      0 0 8px rgba(180, 80, 255, 0.55),
      0 0 18px rgba(180, 80, 255, 0.24),
      inset 0 0 10px rgba(255,255,255,0.08);
  }
  35% {
    box-shadow:
      0 0 16px rgba(70, 255, 246, 0.95),
      0 0 30px rgba(70, 255, 246, 0.6),
      0 0 60px rgba(70, 255, 246, 0.25),
      inset 0 0 16px rgba(255,255,255,0.15);
  }
  100% {
    box-shadow:
      0 0 8px rgba(180, 80, 255, 0.55),
      0 0 18px rgba(180, 80, 255, 0.24),
      inset 0 0 10px rgba(255,255,255,0.08);
  }
}

@keyframes glitterBurst {
  0% {
    opacity: 1;
    transform: translate(0,0) scale(0.7) rotate(0deg);
  }
  100% {
    opacity: 0;
    transform: translate(var(--dx), var(--dy)) scale(1.5) rotate(180deg);
  }
}

@keyframes heartBurst {
  0% {
    opacity: 1;
    transform: translate(0,0) scale(0.5);
  }
  70% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translate(var(--dx), var(--dy)) scale(1.6);
  }
}

@keyframes skullBurst {
  0% {
    opacity: 1;
    transform: translate(0,0) scale(0.5) rotate(0deg);
  }
  70% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translate(var(--dx), var(--dy)) scale(1.5) rotate(var(--rot, 120deg));
  }
}

@keyframes randomSpawn {
  0% {
    opacity: 0;
    transform: translate(0,0) scale(.5);
  }
  25% {
    opacity: 1;
    transform: translate(0,-4px) scale(1.15);
  }
  100% {
    opacity: 0;
    transform: translate(var(--dx), var(--dy)) scale(.8);
  }
}

@keyframes shootingStar {
  0% {
    opacity: 0;
    transform: translate(var(--sx), var(--sy)) scale(.8);
  }
  10% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translate(var(--ex), var(--ey)) scale(1.1);
  }
}
